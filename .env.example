# Postiz (prod host)
POSTIZ_BASE_URL=https://192-168-100-60.sslip.io
POSTIZ_API_TOKEN=your_postiz_api_key_here
POSTIZ_AUTH_STYLE=raw
POSTIZ_PATH_UPLOAD=/public/v1/upload
POSTIZ_PATH_POSTS=/public/v1/posts
# Self-hosted Postiz uses a self-signed cert → keep 0 (disabled verification).
# Set to 1 only when the certificate is trusted.
POSTIZ_VERIFY_TLS=0
# Optional fallback if not set per-platform in config.yaml
POSTIZ_INTEGRATION_ID=

# Telegram Orchestrator bot (not the publisher bot inside Postiz)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=poll

# WebApp later
WEBAPP_PUBLIC_URL=
WEBAPP_DEV=0
