# --- Postiz (публичный API) ---
POSTIZ_BASE_URL=https://192-168-100-60.sslip.io
POSTIZ_API_TOKEN=
POSTIZ_AUTH_STYLE=raw
POSTIZ_PATH_UPLOAD=/public/v1/upload
POSTIZ_PATH_POSTS=/public/v1/posts
POSTIZ_VERIFY_TLS=0
POSTIZ_INTEGRATION_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=off            # poll | off

# --- WebApp ---
WEBAPP_PUBLIC_URL=
WEBAPP_DEV=0
WEBAPP_ACCESS_KEY=           # ключ доступа к панели
WEBAPP_BROWSE_ROOT=/mnt/video,/   # разрешённые корни обзора папок
WEBAPP_RATE_LIMIT=120        # запросов/мин на ключ (0 — выключить)

# --- Token broker (VM с Postiz) ---
TOKEN_BROKER_URL=http://192.168.100.60:9099
TOKEN_BROKER_SECRET=
# на стороне брокера:
BROKER_SECRET=
BROKER_BIND=0.0.0.0
BROKER_PORT=9099
BROKER_PLATFORMS=youtube
BROKER_ALLOW_IPS=192.168.100.50,127.0.0.1
POSTIZ_DB_CONTAINER=postiz-db
POSTIZ_CONTAINER=postiz

# --- n8n (опционально, для engine=n8n) ---
N8N_URL=
N8N_TOKEN=

# --- MCP (локальные серверы для ИИ) ---
ORCH_URL=http://192.168.100.50:8080
ORCH_KEY=
POSTIZ_URL=https://192-168-100-60.sslip.io
POSTIZ_KEY=

# --- Telegram <-> opencode мост ---
BRIDGE_BOT_TOKEN=
BRIDGE_CHAT_ID=
BRIDGE_TIMEOUT=600
OPENCODE_BIN=opencode
OPENCODE_DIR=
OPENCODE_MODEL=
OPENCODE_SESSION=
OPENCODE_AUTO=1

# --- Тесты/локально ---
ORCH_FAST_RETRY=1
