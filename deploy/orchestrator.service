[Unit]
Description=Content Publish Orchestrator v7.3
After=network.target

[Service]
Type=simple
User=orchestrator
WorkingDirectory=/opt/orchestrator
Environment=PYTHONPATH=/opt/orchestrator/src
EnvironmentFile=-/opt/orchestrator/.env
ExecStart=/opt/orchestrator/venv/bin/python -m orchestrator.main --config /opt/orchestrator/config.yaml --db /opt/orchestrator/data/data.sqlite --daemon --health-port 8080
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
